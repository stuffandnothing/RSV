FROM artixlinux/base-runit:latest

# Update system and install dev tools
RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm \
        runit \
        bash \
        bash-completion \
        fish \
        zsh \
        vim \
        git \
        procps-ng \
        && pacman -Scc --noconfirm

# runit needs /etc/runit/sv and runsvdir dirs
RUN mkdir -p /etc/runit/sv \
             /run/runit/runsvdir/default \
             /var/log

# Copy entrypoint that starts runsvdir then drops to shell
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# rsv repo will be mounted here
VOLUME ["/rsv"]

WORKDIR /rsv

ENTRYPOINT ["/entrypoint.sh"]
